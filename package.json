{
  "name": "discord-project-automation-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca --watch --import tsx src/index.ts",
    "register": "tsx src/register-commands.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --use-system-ca dist/index.js",
    "test": "node --import tsx --test tests/calendar-discord.test.ts tests/calendar-state.test.ts tests/config.test.ts tests/github-automation-polling.test.ts tests/github-schedule-sync.test.ts tests/github-webhook.test.ts tests/review-domain.test.ts",
    "google:auth": "tsx scripts/google-calendar-auth.ts",
    "github:webhooks": "tsx scripts/register-automation-webhooks.ts"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^2.19.0",
    "@octokit/rest": "^22.0.1",
    "discord.js": "^14.26.2",
    "dotenv": "^17.4.2",
    "googleapis": "^176.0.0",
    "libsodium-wrappers": "^0.8.4",
    "play-dl": "npm:@iamtraction/play-dl@^2.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
