DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# 기존 길드 전용 slash command 정리가 필요할 때만 사용합니다.
DISCORD_GUILD_ID=
GITHUB_TOKEN=
FIGMA_TOKEN=
NOTION_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=
# 기본 PR 리뷰는 GitHub Actions 정적분석을 사용하며 AI 키가 필요하지 않습니다.
# 아래 키는 기존 signed-webhook AI fallback을 사용할 때만 선택적으로 설정합니다.
GEMINI_API_KEY=
# review workflow가 중앙 collector를 가져올 ref. 비워두면 코드의 기본 ref를 사용합니다.
ISEOL_REVIEW_COLLECTOR_REF=
# signed GitHub webhook fallback (기본 production에서는 비활성)
GITHUB_WEBHOOK_SECRET=
WEBHOOK_PORT=
PUBLIC_BASE_URL=

# Idea Lab real Vercel preview deployment (optional; missing values keep live deploy blocked-external)
VERCEL_TOKEN=
ISEOL_VERCEL_PROJECT_ID=
# Team-owned project only; leave empty for personal projects.
ISEOL_VERCEL_TEAM_ID=

# Production ChatGPT browser driver (optional; dedicated profile must stay outside repo/model/run/web roots)
ISEOL_CHATGPT_BROWSER_ENABLED=
ISEOL_CHATGPT_BROWSER_PROFILE_ROOT=
ISEOL_CHATGPT_BROWSER_EXECUTABLE=
ISEOL_CHATGPT_BROWSER_HEADLESS=
