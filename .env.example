# ─────────────────────────────────────────────
# Core · 필수
# ─────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GITHUB_TOKEN=
FIGMA_TOKEN=
NOTION_TOKEN=

# 기존 길드 전용 slash command 정리가 필요할 때만 잠시 사용합니다.
DISCORD_GUILD_ID=

# Docker에서 외부에 공개할 호스트 포트입니다.
ISEOL_PORT=8787

# ─────────────────────────────────────────────
# Google Calendar · 선택
# ─────────────────────────────────────────────
# Google Cloud OAuth Client를 한 번 준비한 뒤 Discord의
# `📅 Calendar 만들기 → Google Calendar 연결`에서 로그인하면 됩니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=

# 보통 비워둡니다. OAuth 승인 후 refresh token은 data/google-oauth.json에 자동 저장됩니다.
# 기존 설치와 호환하거나 강제로 override할 때만 사용합니다.
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=

# ─────────────────────────────────────────────
# Code Review / GitHub 자동화 · 선택
# ─────────────────────────────────────────────
# 중앙 collector ref를 직접 고정할 때만 사용합니다.
ISEOL_REVIEW_COLLECTOR_REF=

# 기존 signed-webhook AI fallback을 사용할 때만 설정합니다.
GEMINI_API_KEY=
GITHUB_WEBHOOK_SECRET=

# Docker 밖에서 직접 실행할 때 integration HTTP 포트를 바꾸고 싶을 때 사용합니다.
WEBHOOK_PORT=
